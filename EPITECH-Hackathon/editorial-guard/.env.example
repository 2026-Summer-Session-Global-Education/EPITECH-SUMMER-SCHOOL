# A key here is OPTIONAL. You can add keys from the UI instead (recommended).
# If set, this key is seeded once on first run as a convenience.
# ANTHROPIC_API_KEY=sk-ant-...

# Set MODEL to a model your API key can access. Valid ids include
# claude-haiku-4-5 (default, cheapest), claude-sonnet-5, claude-opus-4-8.
# You can also change and test the model from the Settings panel in the UI.
# MODEL=claude-haiku-4-5

# DB_PATH=editorial_guard.db
